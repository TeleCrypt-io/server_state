# Copy to an untracked `.env.billing-test` for the isolated full-stack sandbox.
# These directories must not be the production directories.
TELECRYPT_SECRETS_DIR=/path/to/private/billing-test/secrets
TELECRYPT_DATA_DIR=/path/to/persistent/billing-test/data

# Use a dedicated proxy-facing address/port and route only the test hostnames to it.
INGRESS_BIND_ADDRESS=127.0.0.1
INGRESS_PORT=18080
TRUSTED_PROXY=127.0.0.1/32
IGNORED_PROXY_IP=
