# Copy to `.env` on the Linux VM. Never commit the real file.
TELECRYPT_DATA_DIR=/path/to/persistent/data

# Public identity and addresses are environment-specific and must be set independently in each
# private VM checkout. They are not credentials.
SERVER_NAME=example.invalid
BACKEND_HOST=backend.example.invalid
BILLING_ENV=test

# Compose reads secret files from TELECRYPT_DATA_DIR/secrets. Keep that directory private.

# Dedicated address exposed only to the external TLS proxy, plus that proxy's exact CIDR.
INGRESS_BIND_ADDRESS=127.0.0.1
TRUSTED_PROXY=127.0.0.1/32
