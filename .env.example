# CI/static-validation fixture only. The release workflow and validator consume these documentation
# values; this file is not copied to the Linux VM and must not be used as its runtime environment.
TELECRYPT_DATA_DIR=/path/to/persistent/data

# Public identity is environment-specific. Harness derives backend.<SERVER_NAME> and
# storage.<SERVER_NAME> from it; the landing site remains production-only at www.telecrypt.io.
SERVER_NAME=stage.telecrypt.io
BILLING_ENVIRONMENT=test

# Harness reads the Synapse/MAS secret files from TELECRYPT_DATA_DIR/secrets and passes only those
# file sources to the guarded Compose process. It also snapshots the exact private Janitor/Plan/Cashier
# environment keys before exporting them to Compose. Never add service-private keys to this operator .env.

# Documentation-only TEST-NET values; replace both with the VM and TLS proxy's real host IPs.
# Harness rejects loopback, unspecified, multicast, and link-local addresses.
INGRESS_BIND_ADDRESS=192.0.2.20
# Exact single upstream proxy address only; use /32 for IPv4 or /128 for IPv6.
TRUSTED_PROXY=192.0.2.10/32
