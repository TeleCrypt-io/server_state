# Copy to `.env` on the Linux VM. Never commit the real file.
TELECRYPT_SECRETS_DIR=/path/to/private/secrets
TELECRYPT_DATA_DIR=/path/to/persistent/data

# Dedicated address exposed only to the external TLS proxy, plus that proxy's exact CIDR.
INGRESS_BIND_ADDRESS=127.0.0.1
INGRESS_PORT=8080
TRUSTED_PROXY=127.0.0.1/32
# Optional: a proxy-only X-Forwarded-For value that carries no original-client signal.
IGNORED_PROXY_IP=

# Required only when the optional `voip` profile is enabled.
LIVEKIT_URL=__CHANGEME__
LIVEKIT_KEY=__CHANGEME__
LIVEKIT_SECRET=__CHANGEME__
