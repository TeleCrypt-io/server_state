# TeleCrypt.io — Caddy as a PLAIN-HTTP reverse proxy.
#
# TLS is terminated by an upstream reverse proxy, which forwards cleartext HTTP here. The `http://`
# site prefixes disable Caddy's automatic HTTPS so it serves on the HTTP port only.
#
# Requirements:
#   - This Caddy must join the `telecrypt_net` Docker network to resolve `synapse` / `mas`.
#   - The upstream proxy MUST send `X-Forwarded-Proto: https` (so MAS/Synapse build https URLs and
#     set Secure cookies).
#   - `TRUSTED_PROXY` must be the exact CIDR of the TLS terminator. Redpill's per-source limiter
#     depends on Caddy accepting forwarded client addresses only from that proxy.

# TLS / auto-HTTPS is FULLY disabled: HAProxy terminates TLS and forwards plain HTTP here.
# `auto_https off` stops Caddy from provisioning ANY certificate, opening :443, or doing ACME —
# it serves the HTTP port only and never exposes a domain via auto-SSL.
{
	auto_https off

	servers {
		trusted_proxies static {$TRUSTED_PROXY}
	}
}

# Safe response defaults. Do not use X-Frame-Options here: MAS embeds the Steward page in its own
# account UI. TLS/HSTS policy belongs to the TLS-terminating host, not this HTTP-only proxy.
(security_headers) {
	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
	}
}

# ── APEX (telecrypt.io): well-known discovery + 301 redirect to www ─────────────────────────────
# The apex serves the Matrix server_name domain. .well-known/matrix/client is served here with
# proper CORS/Content-Type headers (GitHub Pages at www can't set those). Everything else 301s to
# https://www.telecrypt.io (the GitHub Pages landing site).
http://telecrypt.io {
	log
	import security_headers

	# .well-known Matrix client discovery (CORS-open, cacheable).
	header /.well-known/matrix/* Content-Type "application/json"
	header /.well-known/matrix/* Access-Control-Allow-Origin "*"
	header /.well-known/matrix/* Cache-Control "max-age=3600"

	@well_known_client path /.well-known/matrix/client
	handle @well_known_client {
		respond `{
			"m.homeserver": {"base_url": "https://backend.telecrypt.io"},
			"org.matrix.msc2965.authentication": {
				"issuer": "https://backend.telecrypt.io/auth/",
				"account": "https://backend.telecrypt.io/auth/account"
			}
		}`
	}

	# No /.well-known/matrix/server — federation is disabled.

	# Everything else → landing site on GitHub Pages.
	handle {
		redir https://www.telecrypt.io{uri} 301
	}
}

# ── BACKEND (backend.telecrypt.io): Matrix stack (Synapse + MAS + Controlplane + Cashier) ──────
http://backend.telecrypt.io {
	log
	import security_headers

	# Administrative APIs are available only over telecrypt_net. The control-plane services use
	# their container addresses directly; browsers and Internet clients must not reach these paths.
	@mas_admin path /auth/api/admin/v1 /auth/api/admin/v1/*
	handle @mas_admin {
		respond "Not Found" 404
	}
	@synapse_admin path /_synapse /_synapse/*
	handle @synapse_admin {
		respond "Not Found" 404
	}
	# Cashier's command API is private Docker-network traffic only. Do not forward this public path.
	@cashier_internal path /internal /internal/*
	handle @cashier_internal {
		respond "Not Found" 404
	}

	# Legacy Matrix password compatibility login must never reach MAS or Synapse.
	# MAS-hosted /auth/login remains available for OAuth browser/device approval.
	@matrix_compat_login path_regexp ^/_matrix/client/(.*)/login/?$
	handle @matrix_compat_login {
		respond "Not Found" 404
	}

	# Retain only MAS compatibility logout/refresh routes required by Matrix clients.
	@mas_compat path_regexp ^/_matrix/client/(.*)/(logout|refresh)/?$
	handle @mas_compat {
		reverse_proxy mas:8080
	}

	# … and everything under /auth (its UI, OAuth2, discovery, account).
	# Strip the /auth prefix before forwarding — MAS serves everything at its root internally.
	@mas path /auth /auth/*
	handle @mas {
		uri strip_prefix /auth
		reverse_proxy mas:8080
	}

	# Everything else Matrix → Synapse. /_synapse is deliberately excluded: see admin block above.
	@synapse path_regexp ^(/_matrix|/health)
	handle @synapse {
		reverse_proxy synapse:8008
	}

	# Agent on-ramp accepts POST only. Return 405 at the edge rather than proxying other methods.
	@redpill_post {
		method POST
		path /redpill
	}
	handle @redpill_post {
		reverse_proxy controlplane:9009
	}
	@redpill_other_method path /redpill
	handle @redpill_other_method {
		header Allow "POST"
		respond "Method Not Allowed" 405
	}

	# Steward owns every browser route. Canonical Plan actions use /api/plan; retain /api/team
	# for cached legacy pages until their compatibility window closes. Dodo card data is entered only
	# on the provider-hosted checkout.
	@plan path /plan /plan/* /api/plan /api/plan/* /api/team /api/team/*
	handle @plan {
		reverse_proxy steward:9012
	}
	# Cashier has no browser surface. DODO_WEBHOOK_PATH is a mode-600 ingress secret; Caddy rewrites
	# that external capability URL to Cashier's canonical internal handler.
	@dodo_webhook {
		method POST
		path {$DODO_WEBHOOK_PATH}
	}
	handle @dodo_webhook {
		uri replace {$DODO_WEBHOOK_PATH} /webhooks/dodo
		reverse_proxy cashier:9011
	}
	# Transitional compatibility route. Remove in a subsequent immutable state release after the
	# Dodo test endpoint has been moved to DODO_WEBHOOK_PATH.
	@legacy_dodo_webhook {
		method POST
		path /webhooks/dodo
	}
	handle @legacy_dodo_webhook {
		reverse_proxy cashier:9011
	}

	# Future: LiveKit JWT service (staged off until VoIP wiring — see compose.yml lkjwt service)
	# @lkjwt path /jwt /jwt/*
	# handle @lkjwt {
	# 	reverse_proxy lkjwt:8080
	# }

	# Everything else → minimal placeholder.
	handle {
		respond "TeleCrypt.io backend" 200
	}
}
