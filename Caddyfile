# TeleCrypt.io — Caddy as a PLAIN-HTTP reverse proxy.
#
# TLS is terminated by an upstream reverse proxy, which forwards cleartext HTTP here. The `http://`
# site prefixes disable Caddy's automatic HTTPS so it serves on the HTTP port only.
#
# Requirements:
#   - Compose places Caddy on one dedicated internal edge network per routed upstream; it has no
#     network path to Janitor or MAS's private admin listener.
#   - It listens on unprivileged container port 8080; Compose maps the proxy-facing host port to it.
#   - The upstream proxy MUST send `X-Forwarded-Proto: https` (so MAS/Synapse build https URLs and
#     set Secure cookies).
#   - `TRUSTED_PROXY` must be exactly one TLS-terminator host address (/32 or /128). Caddy uses it
#     to trust only that proxy's forwarded protocol and client context; application identity and
#     rate limiting do not depend on a forwarded client-IP header.
#   - For rootless Docker, this peer gate is activation-valid only with RootlessKit >= 3.0's
#     `slirp4netns` port driver and userland-proxy disabled. Harness must verify those
#     exact host conditions and prove the observed peer/X-Forwarded behavior live; other publish paths
#     do not satisfy this boundary.

# TLS / auto-HTTPS is FULLY disabled: HAProxy terminates TLS and forwards plain HTTP here.
# `auto_https off` stops Caddy from provisioning ANY certificate, opening :443, or doing ACME —
# it serves the HTTP port only and never exposes a domain via auto-SSL.
{
	auto_https off

	servers {
		trusted_proxies static {$TRUSTED_PROXY}
		trusted_proxies_strict
	}

	servers :8080 {
		protocols h1
	}
}

# Safe response defaults. MAS embeds the Plan page from the same backend origin; Plan's own
# same-origin framing policy remains authoritative. Do not add a wildcard or third-party frame
# permission here. TLS/HSTS policy belongs to the TLS-terminating host, not this HTTP-only proxy.
(security_headers) {
	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
	}
}

# Keep paths and response details for diagnosis without retaining OAuth or other secret query data.
# Credential headers and response cookies are excluded as well.
(access_log) {
	log {
		format filter {
			request>uri regexp "[?].*" "?[REDACTED]"
			request>headers>Authorization delete
			request>headers>Cookie delete
			request>headers>Proxy-Authorization delete
			resp_headers>Set-Cookie delete
		}
	}
}

# No upstream may trust a client-selected identity header. Remove the obsolete client-IP header
# from every forwarded request; no current service consumes it for identity or rate limiting.
(strip_untrusted_client_ip) {
	header_up -X-Telecrypt-Client-IP
}

# Caddy must be reachable only from the configured TLS terminator. `remote_ip` is the immediate
# transport peer and is deliberately independent of forwarded-client-IP trust. The Docker/rootless
# host publish path must preserve the configured proxy peer; the external terminator cannot do that
# after the request crosses the host boundary. See the RootlessKit/userland-proxy prerequisite above.
(ingress_peer_gate) {
	@untrusted_ingress_peer {
		not remote_ip {$TRUSTED_PROXY}
	}
	handle @untrusted_ingress_peer {
		abort
	}
}

# ── APEX (SERVER_NAME): well-known discovery + production-only landing redirect ─────────────────
# The apex serves the Matrix server_name domain. .well-known/matrix/client is served here with
# proper CORS/Content-Type headers (GitHub Pages at www can't set those). Only the production
# profile redirects ordinary requests to the landing site; stage has no public website and returns
# a bounded 404 instead of redirecting into production.
http://{$SERVER_NAME}:8080 {
	import ingress_peer_gate
	import access_log
	import security_headers

	# .well-known Matrix client discovery (CORS-open, cacheable).
	header /.well-known/matrix/* Content-Type "application/json"
	header /.well-known/matrix/* Access-Control-Allow-Origin "*"
	header /.well-known/matrix/* Cache-Control "max-age=3600"

	@well_known_client {
		method GET
		path /.well-known/matrix/client
	}
	handle @well_known_client {
		respond `{
				"m.homeserver": {"base_url": "https://backend.{$SERVER_NAME}"},
				"org.matrix.msc2965.authentication": {
					"issuer": "https://backend.{$SERVER_NAME}/auth/",
					"account": "https://backend.{$SERVER_NAME}/auth/account"
			}
		}`
	}

	# Federation is disabled. Return the discovery endpoint directly instead of allowing the
	# production apex redirect to advertise or delegate a federation target.
	handle /.well-known/matrix/server {
		respond "Not Found" 404
	}

	# The public website exists only for the production profile. Match the literal production
	# identity so a stage deployment cannot redirect users or credentials into production.
	@production_apex host telecrypt.io
	handle @production_apex {
		# Drop the query string so callback codes or other secrets cannot be carried to the landing site.
		redir https://www.telecrypt.io{http.request.uri.path} 301
	}
	handle {
		respond "Not Found" 404
	}
}

# ── BACKEND (derived from SERVER_NAME): Synapse + MAS + Registration + Plan + Cashier ──────────
http://backend.{$SERVER_NAME}:8080 {
	import ingress_peer_gate
	import access_log
	import security_headers

	# Administrative APIs are available only over private application networks. Browsers and Internet
	# clients must not reach these paths.
	@mas_admin path /auth/api/admin /auth/api/admin/*
	handle @mas_admin {
		respond "Not Found" 404
	}
	@synapse_admin path /_synapse /_synapse/*
	handle @synapse_admin {
		respond "Not Found" 404
	}
	# Cashier's command API is private Docker-network traffic only. Do not forward this public path.
	@cashier_internal path /internal /internal/*
	handle @cashier_internal {
		respond "Not Found" 404
	}

	# Matrix password login must never reach MAS or Synapse.
	# MAS-hosted /auth/login remains available for OAuth browser/device approval.
	@matrix_compat_login path_regexp ^/_matrix/client/[^/]+/login/?$
	handle @matrix_compat_login {
		respond "Not Found" 404
	}

	# Retain only POST MAS logout/refresh routes required by Matrix clients. Reject every other
	# method before the generic Synapse matcher below can see the path.
	@mas_compat_other_method {
		path_regexp ^/_matrix/client/[^/]+/(logout|refresh)/?$
		not method POST
	}
	handle @mas_compat_other_method {
		header Allow "POST"
		respond "Method Not Allowed" 405
	}
	@mas_compat {
		method POST
		path_regexp ^/_matrix/client/[^/]+/(logout|refresh)/?$
	}
	handle @mas_compat {
		reverse_proxy mas:8080 {
			import strip_untrusted_client_ip
		}
	}

	# Keep the edge admission limit equal to Synapse's exact 128 MiB plaintext limit.
	# The request body is bounded before it reaches the application or staging disk.
	@media_upload {
		method POST PUT
		path_regexp ^/_matrix/media/(r0|v1|v3)/upload(/[^/]+/[^/]+)?/?$
	}
	handle @media_upload {
		request_body {
			max_size 128MiB
		}
		reverse_proxy synapse:8008 {
			import strip_untrusted_client_ip
		}
	}

	# … and everything under /auth (its UI, OAuth2, discovery, account).
	# Strip the /auth prefix before forwarding — MAS serves everything at its root internally.
	@mas path /auth /auth/*
	handle @mas {
		uri strip_prefix /auth
		reverse_proxy mas:8080 {
			import strip_untrusted_client_ip
		}
	}

	# Media deletion is an authenticated Synapse operation, but only POST is part of its contract.
	# Answer the browser preflight at the edge with only the headers required by the Storage Web
	# POST. The origin is the exact current environment's Storage host; no arbitrary-origin
	# reflection or wildcard CORS is allowed.
	@telecrypt_delete_media_options {
		method OPTIONS
		path /_matrix/client/unstable/io.telecrypt.storage/delete_media
		header Origin https://storage.{$SERVER_NAME}
		header Access-Control-Request-Method POST
	}
	handle @telecrypt_delete_media_options {
		header {
			Access-Control-Allow-Origin "https://storage.{$SERVER_NAME}"
			Access-Control-Allow-Methods "POST"
			Access-Control-Allow-Headers "Authorization, Content-Type"
		}
		respond "" 204
	}

	# Reject other methods at the edge and cap accepted deletion batches before proxying them.
	@telecrypt_delete_media_other_method {
		path /_matrix/client/unstable/io.telecrypt.storage/delete_media
		not method POST
	}
	handle @telecrypt_delete_media_other_method {
		header Allow "POST, OPTIONS"
		respond "Method Not Allowed" 405
	}
	@telecrypt_delete_media {
		method POST
		path /_matrix/client/unstable/io.telecrypt.storage/delete_media
	}
	handle @telecrypt_delete_media {
		request_body {
			max_size 32KiB
		}
		reverse_proxy synapse:8008 {
			import strip_untrusted_client_ip
		}
	}

	# Enabled Matrix client and media resources → Synapse. /_synapse and other Matrix resources are
	# deliberately excluded: see the admin block above and the listener resources in synapse.yaml.
	@synapse path_regexp ^/_matrix/(client|media)(/|$)
	handle @synapse {
		reverse_proxy synapse:8008 {
			import strip_untrusted_client_ip
		}
	}

	# Agent on-ramp accepts POST only. Return 405 at the edge rather than proxying other methods.
	@agents_post {
		method POST
		path /agents
	}
	handle @agents_post {
		reverse_proxy registration:9009 {
			import strip_untrusted_client_ip
		}
	}
	@agents_other_method {
		path /agents
		not method POST
	}
	handle @agents_other_method {
		header Allow "POST"
		respond "Method Not Allowed" 405
	}

	# Plan owns every browser route. Canonical Plan actions use /api/plan. Dodo card data is entered only
	# on the provider-hosted checkout.
	@plan path /plan /plan/* /api/plan /api/plan/*
	handle @plan {
		reverse_proxy plan:9012 {
			import strip_untrusted_client_ip
		}
	}
	# Cashier has no browser surface. The provider's fixed signed webhook endpoint is the only public
	# Cashier route; do not record it in access logs, including rejected methods.
	@dodo_webhook_path path /webhooks/dodo
	log_skip @dodo_webhook_path
	@dodo_webhook {
		method POST
		path /webhooks/dodo
	}
	handle @dodo_webhook {
		header Cache-Control "no-store"
		reverse_proxy cashier:9011 {
			import strip_untrusted_client_ip
		}
	}

	# Everything else is outside the published application surface.
	handle {
		respond "Not Found" 404
	}
}
