# Cashier secrets — TEMPLATE.
# Deploy as cashier.secrets.env in TELECRYPT_SECRETS_DIR with mode 600.
# env_file is read by the docker compose CLI (host user), not the container.

SYNAPSE_ADMIN_TOKEN=__CHANGEME_MCT_TOKEN__
MAS_OIDC_CLIENT_ID=__CHANGEME_ULID_CASHIER__
MAS_OIDC_CLIENT_SECRET=__CHANGEME__
SESSION_KEY=__CHANGEME_OPENSSL_RAND_HEX_32__
CONTROLPLANE_DB_URL=postgres://controlplane_user:__CHANGEME__@__DB_HOST__:5432/telecrypt_controlplane?sslmode=require
TELECRYPT_ENV=test
DODO_API_BASE=https://test.dodopayments.com
DODO_API_KEY=__CHANGEME_SANDBOX_OR_LIVE__
DODO_WEBHOOK_SECRET=__CHANGEME__
DODO_PRODUCT_ID=__CHANGEME_TEST_PRODUCT_ID__
