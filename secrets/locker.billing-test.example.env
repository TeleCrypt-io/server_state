# Copy to locker.secrets.env inside the dedicated billing-test TELECRYPT_SECRETS_DIR.
MAS_ADMIN_CLIENT_ID=__CHANGEME_TEST_ULID_MAS_ADMIN__
MAS_ADMIN_CLIENT_SECRET=__CHANGEME__
# Must exactly match CONTROLPLANE_DB_URL in cashier.secrets.env so janitor sees billing and manual
# grants from the same isolated enforcement database.
CONTROLPLANE_DB_URL=postgres://controlplane_test_user:__CHANGEME__@__TEST_DB_HOST__:5432/telecrypt_controlplane_test?sslmode=require
OWNER_EMAIL=__CHANGEME_TEST_RECIPIENT__
SMTP_HOST=__CHANGEME_TEST_SMTP_HOST__
SMTP_PORT=587
SMTP_USERNAME=__CHANGEME__
SMTP_PASSWORD=__CHANGEME__
SMTP_FROM=__CHANGEME__
