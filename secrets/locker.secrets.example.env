# janitor — the ONE deployed component holding a standing MAS admin credential.
# Deploy as locker.secrets.env in TELECRYPT_SECRETS_DIR and replace every placeholder.
# env_file is read by the `docker compose` CLI itself (user `ubuntu`) — chown ubuntu:ubuntu,
# mode 600 (NOT the container subuid; that's only for bind-mounted secrets).

# MAS admin client (client_credentials, client_secret_basic, scope urn:mas:admin).
# Must equal mas.secrets.yaml clients[0].client_id / .client_secret (the static admin client).
MAS_ADMIN_CLIENT_ID=__CHANGEME__
MAS_ADMIN_CLIENT_SECRET=__CHANGEME__

# External control-plane PostgreSQL.
CONTROLPLANE_DB_URL=postgres://controlplane_user:__CHANGEME__@__DB_HOST__:5432/telecrypt_controlplane_prod_matrix_dodo_test?sslmode=require

# Owner digest (new sign-ups with an email, awaiting manual review).
OWNER_EMAIL=__CHANGEME__
SMTP_HOST=__CHANGEME__
SMTP_PORT=587
SMTP_USERNAME=__CHANGEME__
SMTP_PASSWORD=__CHANGEME__
SMTP_FROM=__CHANGEME__
