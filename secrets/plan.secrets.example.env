# Public Plan secrets — TEMPLATE. Deploy as plan.secrets.env with mode 600.
# Cashier must never receive these browser/OIDC/signing-private-key values.
MAS_OIDC_CLIENT_ID=__CHANGEME_ULID_PLAN__
MAS_OIDC_CLIENT_SECRET=__CHANGEME__
SESSION_KEY=__CHANGEME_OPENSSL_RAND_HEX_32__
# Raw URL-safe base64 Ed25519 private key. Its matching public key belongs only in cashier.secrets.env.
PLAN_ASSERTION_PRIVATE_KEY=__CHANGEME__
